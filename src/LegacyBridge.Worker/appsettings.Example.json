{
  "Bridge": {
    "SourceName": "erp-demo",
    "PollingIntervalSeconds": 5,
    "BatchSize": 100,
    "Firebird": {
      "ConnectionString": "DataSource=localhost;Port=3050;Database=/var/lib/firebird/data/erp_demo.fdb;User=BRIDGE;Password=<SENHA_DO_FIREBIRD>;Charset=UTF8",
      "ChangelogTable": "BRIDGE_CHANGELOG",
      "ServerTimeZone": "America/Sao_Paulo"
    },
    "Tables": [
      { "Table": "CLIENTES", "Entity": "cliente", "KeyColumn": "ID" },
      { "Table": "PRODUTOS", "Entity": "produto", "KeyColumn": "ID" },
      { "Table": "PEDIDOS",  "Entity": "pedido",  "KeyColumn": "ID" }
    ],
    "Webhook": {
      "Url": "https://exemplo.invalid/webhook",
      "Secret": "<GERE_UM_SEGREDO_ALEATORIO_COM_32+_CARACTERES>",
      "TimeoutSeconds": 10
    },
    "Retry": { "MaxAttempts": 10, "BaseDelaySeconds": 2, "MaxDelaySeconds": 300 },
    "Storage": { "SqlitePath": "data/bridge.db" }
  }
}
