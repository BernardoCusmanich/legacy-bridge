# Copie para .env (que está no .gitignore) e troque os valores.
# Sem .env, o docker-compose usa segredos de demonstração embutidos.

FIREBIRD_ROOT_PASSWORD=troque-esta-senha-root
FIREBIRD_PASSWORD=troque-esta-senha

# Mínimo de 32 caracteres. Gere com: openssl rand -hex 32
BRIDGE_WEBHOOK_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres

# Proporção (0–1) de requisições que o receptor responde com 503 para demonstrar o retry.
FAIL_RATE=0.2

# Intervalo, em segundos, entre as mudanças geradas pelo simulador.
SIMULATOR_INTERVAL_SECONDS=3
